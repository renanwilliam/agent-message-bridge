{
  "name": "agent-message-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renanwilliam/agent-message-bridge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p viewer/tsconfig.json",
    "check": "npm run build:viewer && npm run typecheck && npm test",
    "demo": "node --import tsx scripts/demo.ts",
    "start": "node --import tsx src/local.ts",
    "package": "serverless package",
    "build:viewer": "vite build && node scripts/embed-viewer.mjs",
    "prestart": "npm run build:viewer",
    "prepackage": "npm run build:viewer",
    "test:viewer": "playwright test",
    "viewer:demo": "node --import tsx scripts/viewer-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1123.0",
    "@aws-sdk/client-secrets-manager": "3.1123.0",
    "@aws-sdk/client-sqs": "^3.1123.0",
    "@aws-sdk/lib-dynamodb": "3.1123.0",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ipaddr.js": "2.3.0",
    "jose": "6.1.3",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "serverless": "4.46.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.22.0",
    "typescript": "5.9.3",
    "vite": "^8.3.7",
    "yaml": "2.8.3"
  }
}
